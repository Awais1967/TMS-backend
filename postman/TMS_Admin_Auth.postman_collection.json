{
  "info": {
    "name": "TMS Admin Backend - Auth",
    "description": "Postman collection for testing TMS Backend foundation and admin auth endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4008",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "password123",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Health response is successful', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.message).to.eql('TMS API is running');",
                  "  pm.expect(json.data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/login - Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns success when DB and admin seed are ready', function () {",
                  "  pm.expect([200, 503]).to.include(pm.response.code);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Login response has token', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.token).to.be.a('string').and.not.empty;",
                  "  });",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}",
                  "",
                  "if (pm.response.code === 503) {",
                  "  pm.test('Database unavailable message is clean', function () {",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.message).to.eql('Database connection is not available');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login - Wrong Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Wrong password returns auth or DB error', function () {",
                  "  pm.expect([401, 503]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response uses error format', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(false);",
                  "  pm.expect(json.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me - With Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Me returns expected protected-route status', function () {",
                  "  pm.expect([200, 401, 503]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response uses standard format', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.a('boolean');",
                  "  pm.expect(json.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me - No Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No token returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('No token response is clean', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(false);",
                  "  pm.expect(json.message).to.eql('Authorization token is required');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout returns expected protected-route status', function () {",
                  "  pm.expect([200, 401, 503]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response uses standard format', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.a('boolean');",
                  "  pm.expect(json.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
